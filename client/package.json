{
  "name": "vyuha-trainer",
  "version": "1.1.0-rc.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/offline.mjs",
    "test": "tsx --test src/*.test.ts src/*.test.tsx",
    "lint": "eslint src vite.config.ts --max-warnings 0",
    "test:a11y": "tsx --test src/accessibility.test.tsx",
    "format:check": "prettier --check \"src/*.tsx\" src/useModalFocus.ts src/useRenderingQuality.ts src/useOfflineStatus.ts src/useWorkspaceNavigation.ts src/useCommandTransport.ts src/useContactMemory.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.71.1",
    "vite": "^6.0.0"
  }
}
